      RowBox[{
       RowBox[{"0", ".."}], "2", "j", " ", "of", " ", 
       RowBox[{"q", "^", 
        RowBox[{"(", 
         RowBox[{"n", "/", "2"}], ")"}]}], "*", 
       RowBox[{"chiPoly", "[", 
        RowBox[{"j", "-", 
         RowBox[{"n", "/", "2"}]}], "]"}]}]}], "*)"}], 
    RowBox[{
     RowBox[{"sumTerms", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "^", 
          RowBox[{"(", 
           RowBox[{"n", "/", "2"}], ")"}]}], "*", 
