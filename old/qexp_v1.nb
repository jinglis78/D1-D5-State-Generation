     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"multiply", " ", "by", " ", 
        RowBox[{
         RowBox[{"q", "^", "j"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", "q"}], ")"}]}], " ", "and", " ", "expand", " ", 
        "as", " ", "a", " ", "q"}], "-", 
       RowBox[{"series", " ", "up", " ", "to", " ", "qOrder"}]}], "*)"}], 
     RowBox[{"expr", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", "^", 
          RowBox[{"(", 
           RowBox[{"j", "*", " ", "yPower"}], ")"}]}], "*", "sumTerms"}], 
        ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"q", "^", 
          RowBox[{"(", "yPower", ")"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Normal", "@", 
      RowBox[{"Series", "[", 
       RowBox[{"expr", ",", 
