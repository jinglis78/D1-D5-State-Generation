Notebook[{
Cell[BoxData[{
 RowBox[{"ClearAll", "[", "alpha", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"alpha", ",", 
     RowBox[{"{", "Protected", "}"}]}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "non"}], "-", 
    RowBox[{"commutative", " ", "multiplication"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"commRules", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"alpha", "[", "m_", "]"}], "**", 
       RowBox[{"alpha", "[", "n_", "]"}]}], ":>", 
      RowBox[{
       RowBox[{
        RowBox[{"alpha", "[", "n", "]"}], "**", 
        RowBox[{"alpha", "[", "m", "]"}]}], "+", 
       RowBox[{"m", "*", 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{
          RowBox[{"m", "+", "n"}], ",", "0"}], "]"}]}]}]}], "}"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Example", ":", 
    RowBox[{"compute", "[", 
     RowBox[{"\[Alpha]_m", ",", "\[Alpha]_n"}], "]"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"commutator", "[", 
    RowBox[{"op1_", ",", "op2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"op1", "**", "op2"}], "-", 
    RowBox[{"op2", "**", "op1"}]}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"commutator", "[", 
    RowBox[{
     RowBox[{"alpha", "[", "3", "]"}], ",", 
     RowBox[{"alpha", "[", 
      RowBox[{"-", "3"}], "]"}]}], "]"}], "//.", "commRules"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "[", "psi", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetAttributes", "[", 
    RowBox[{"psi", ",", 
     RowBox[{"{", "Protected", "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"anticommRules", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"psi", "[", "r_", "]"}], "**", 
       RowBox[{"psi", "[", "s_", "]"}]}], ":>", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"psi", "[", "s", "]"}], "**", 
         RowBox[{"psi", "[", "r", "]"}]}]}], "+", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{
         RowBox[{"r", "+", "s"}], ",", "0"}], "]"}]}]}], "}"}]}], ";"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "anticommutator"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"anticommutator", "[", 
    RowBox[{"op1_", ",", "op2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"op1", "**", "op2"}], "+", 
    RowBox[{"op2", "**", "op1"}]}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"anticommutator", "[", 
   RowBox[{
    RowBox[{"psi", "[", 
     RowBox[{"1", "/", "2"}], "]"}], ",", 
    RowBox[{"psi", "[", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], "]"}]}], "]"}], "//.", 
  "anticommutRules"}], "\n"}], "Input",
