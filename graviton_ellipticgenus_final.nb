            RowBox[{"(", 
             RowBox[{"h", "+", "jp"}], ")"}]}], "*", 
           RowBox[{"phiLongPoly", "[", 
            RowBox[{"jp", ",", "h", ",", "q", ",", " ", "y"}], "]"}]}], ",", 
