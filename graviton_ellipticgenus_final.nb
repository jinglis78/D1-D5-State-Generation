          RowBox[{"phiLongPoly", "[", 
           RowBox[{"j", ",", "h", ",", "q", ",", " ", "y"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"j1", "-", "j2"}], "]"}], ",", 
            RowBox[{"j1", "+", "j2", "-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", 
          RowBox[{"j1", "+", "j2"}], ",", 
          RowBox[{"j1", "+", "j2", "+", "20"}], ",", "1"}], "}"}]}], " ", 
       RowBox[{"(*", 
